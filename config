// Total.js Proxy

// Contact for the Let's Encrypt account (optional). Running Proxy means accepting
// the terms of the ACME server below.
email          :

// ACME server. For tests: https://acme-staging-v02.api.letsencrypt.org/directory
acme           : https://acme-v02.api.letsencrypt.org/directory

// Ports
http           : 80
https          : 443

// DNS server for wildcard certificates: it runs when dns_zone has a zone (empty: off), on the port of "dns" (53;
// 0 is any free port, for tests). dns_zone is the zone delegated to this server (an NS record pointing to dns_ns).
dns            : 0
dns_zone       :
dns_ns         :

// Routes, certificates and the Let's Encrypt account
data           : data
// Optional base directory for explicit certificate file paths (empty: data/tls).
custom_cert_dir :
// Optional read-only JSON route list. Leave empty for routes managed through the control API.
routes_file    :
// Optional snapshot from the Docker watchdog. Requires a separate routes_file.
docker_routes_file :

// Control API for Code: a Unix socket (in a folder of its own, the only one Code shares with Proxy), or host:port
// together with a token
control        : control/proxy.sock
token          :
// Optional JSON file of scoped tokens and hostname allowlists for shared Proxy.
control_clients_file :

// Days before expiry to renew a certificate
renew_days     : 30

// HTTP connections to each upstream and idle connections retained for reuse
upstream_connections      : 128
upstream_idle_connections : 128

// Concurrent HTTP requests and WebSocket upgrades/connections, globally and per route
http_active              : 2048
http_active_per_route    : 256
ws_active                : 1024
ws_active_per_route      : 128

// Every site. Headers added when the app does not send them: "Name: value | Name: value"
// (Strict-Transport-Security only over HTTPS). For example:
// headers     : X-Content-Type-Options: nosniff | Strict-Transport-Security: max-age=31536000; includeSubDomains
headers        :
// The value of HSTS for the routes that turn it on
hsts           : max-age=31536000
// Largest request body in MB of the routes without their own
maxupload      : 50
// Brotli or gzip for the text that the apps send uncompressed
compress       : true
// Own pages for the answers of Proxy: 401.html, 403.html, 404.html, 413.html, 502.html, 504.html
errors         : data/errors
// Operational events: stdout (default), off, or a directory with a daily proxy-YYYY-MM-DD.log file.
eventlog       : stdout
// Access log: empty (off), stdout, or a folder with one file a day kept accesslog_days days, up to accesslog_maxsize MB
// a day
accesslog      :
// When a destination is configured, log routes without an explicit accesslog option.
accesslog_default : true
accesslog_days : 14
accesslog_maxsize : 500
